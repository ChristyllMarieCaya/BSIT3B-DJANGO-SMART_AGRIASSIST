# ==============================================================================
# SMART Agricultural Assistant - Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to ".env" in the project root and replace every placeholder.
# Never commit the real ".env" file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Security & Core Settings
# ------------------------------------------------------------------------------
# Generate a production key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SITE_URL=http://127.0.0.1:8000

# HTTPS / cookie behaviour. These default to True automatically when
# DJANGO_DEBUG=False. Set them to False only if your host does not serve HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Optional HSTS (start with 0, enable after HTTPS is confirmed working):
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Run the in-process automation thread. Defaults to DJANGO_DEBUG, so it is on
# locally and off in production. Keep it off in production and use the
# PythonAnywhere Scheduled Task described in the deployment guide instead.
# ENABLE_BACKGROUND_SCHEDULER=False

# ------------------------------------------------------------------------------
# PythonAnywhere production example (uncomment and edit on the server)
# ------------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=USERNAME.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com
# SITE_URL=https://USERNAME.pythonanywhere.com
# DJANGO_SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# DB_ENGINE choices: 'sqlite' (default, zero-setup), 'mysql', or 'postgres'
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Required when DB_ENGINE=mysql or DB_ENGINE=postgres.
# For PythonAnywhere MySQL use:
#   DB_NAME=yourusername$smart_agri
#   DB_USER=yourusername
#   DB_HOST=yourusername.mysql.pythonanywhere-services.com
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# Google Gemini Vision & LLM AI Assistant
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=replace-with-a-long-random-secret-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_CONNECT_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Weather API (optional)
# ------------------------------------------------------------------------------
# The app uses Open-Meteo by default and does not require a weather API key.
# This value is reserved for optional OpenWeatherMap integrations.
OPENWEATHER_API_KEY=replace-with-a-long-random-secret-key

# ------------------------------------------------------------------------------
# Email / Notification Settings (Optional)
# ------------------------------------------------------------------------------
# Leave EMAIL_HOST empty to print emails to the console during development.
# Configure these to enable real email delivery for severe weather alerts.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="SMART AGRIASSIST <no-reply@your-domain.example>"

# ------------------------------------------------------------------------------
# Celery & Asynchronous Task Worker (Optional)
# ------------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
